# Copy to .env (or export in your shell) — never commit real keys.

# LLM fallback — leave empty to run pure-ML (the service degrades gracefully)
OPENAI_API_KEY=

# Confidence below which a cluster is escalated to the LLM
# (0.40 = LOSO-benchmark knee, see scripts/tune_threshold.py)
LLM_CONFIDENCE_THRESHOLD=0.40

# Candidate-node count above which gpt-4o is used instead of gpt-4o-mini
LLM_COMPLEXITY_NODE_THRESHOLD=40
LLM_SIMPLE_MODEL=gpt-4o-mini
LLM_COMPLEX_MODEL=gpt-4o

# Hard USD cap per request — escalation is refused past it
LLM_MAX_COST_PER_REQUEST=0.05

# Where request logs are appended (JSONL)
MONITORING_PATH=data/monitoring/requests.jsonl

# Streamlit demo: point at a deployed API instead of the local pipeline
# API_URL=https://event-extraction-api.onrender.com
